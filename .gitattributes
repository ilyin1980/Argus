# Batch files are parsed line by line by cmd.exe, which requires CRLF. With LF
# endings it executes the comments as commands, which fails in a way that points
# nowhere near the real cause.
*.bat text eol=crlf
*.cmd text eol=crlf

# Shell scripts must keep LF even when checked out on Windows, or the shebang
# line carries a stray carriage return and the interpreter is "not found".
*.sh  text eol=lf

# Workflow files are executed by a Linux shell on the runner. A CRLF checkout
# leaves a carriage return at the end of every command in a `run:` block.
*.yml  text eol=lf
*.yaml text eol=lf

# Everything else: normalise in the repository, native on checkout.
*.cpp  text
*.h    text
*.txt  text
*.md   text
*.json text
*.ui   text
*.ps1  text

# Never touched by line-ending conversion.
*.png  binary
*.svg  text
*.ico  binary
*.icns binary

# Qt translation catalogues are XML. Without this GitHub reads the extension as
# TypeScript and reports the project as a TypeScript one.
translations/*.ts text linguist-language=XML
*.ui              text linguist-language=XML

# The translated manuals are documentation, not source, and would otherwise
# dominate the language statistics of a C++ project.
src/gui/help/*.md linguist-documentation=true

# Builds are published as release assets, never committed: two archives of a
# few hundred megabytes each would sit in history forever, and Git LFS on the
# free plan allows 1 GB of traffic a month, which a handful of clones exhausts.
# These rules exist so that any binary added later lands in LFS by accident
# rather than in history, where removing it costs a rewrite of every commit.
*.zip   filter=lfs diff=lfs merge=lfs -text
*.7z    filter=lfs diff=lfs merge=lfs -text
*.tar   filter=lfs diff=lfs merge=lfs -text
*.gz    filter=lfs diff=lfs merge=lfs -text
*.onnx  filter=lfs diff=lfs merge=lfs -text
*.dll   filter=lfs diff=lfs merge=lfs -text
*.so    filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.exe   filter=lfs diff=lfs merge=lfs -text
*.lib   filter=lfs diff=lfs merge=lfs -text
*.a     filter=lfs diff=lfs merge=lfs -text
